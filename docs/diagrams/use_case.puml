
@startuml use_case
left to right direction
skinparam packageStyle rectangle

actor "Администратор" as Admin
actor "Преподаватель" as Teacher
actor "Новый пользователь" as User

package "Учет преподавателей и дисциплин" {

    usecase "Авторизация" as UC_Auth
    usecase "Регистрация" as UC_Register
    usecase "Выход из системы" as UC_Logout

    usecase "Добавить преподавателя" as UC_Add
    usecase "Удалить преподавателя" as UC_Delete
    usecase "Редактировать данные преподавателя" as UC_Edit
    usecase "Просмотреть список преподавателей" as UC_View
    usecase "Найти преподавателя по ФИО" as UC_Find
    usecase "Привязать аккаунт к преподавателю" as UC_Link

    usecase "Добавить дисциплину" as UC_AddDisc
    usecase "Редактировать дисциплину" as UC_EditDisc
    usecase "Удалить дисциплину" as UC_DeleteDisc
    usecase "Назначить дисциплину преподавателю" as UC_Assign

    usecase "Просмотреть свои данные" as UC_ViewOwn
    usecase "Просмотреть свои дисциплины" as UC_ViewDisc
}

User --> UC_Register
Admin --> UC_Auth
Teacher --> UC_Auth

Admin --> UC_Logout
Teacher --> UC_Logout

Admin --> UC_Add
Admin --> UC_Delete
Admin --> UC_Edit
Admin --> UC_View
Admin --> UC_Find
Admin --> UC_Link

Admin --> UC_AddDisc
Admin --> UC_EditDisc
Admin --> UC_DeleteDisc
Admin --> UC_Assign

Teacher --> UC_ViewOwn
Teacher --> UC_ViewDisc

@enduml
